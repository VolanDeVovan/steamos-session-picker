#!/bin/sh
# Print the sessions to offer, as one JSON array.
#
# Shared by both halves: the session at boot and the overlay inside Game Mode
# show the same list, discovered the same way, so adding a session anywhere makes
# it appear in both with nothing edited here.
set -u

# The directories steamos-manager enumerates, in its own order. The picker's own
# entry is installed into /usr/local/share/wayland-sessions like any other.
SESSION_DIRS="/usr/local/share/wayland-sessions
/usr/local/share/xsessions
/usr/share/wayland-sessions
/usr/share/xsessions"

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Desktop entries carry one plain key and a long tail of Name[xx]= translations;
# only the untranslated one is wanted.
entry_field() {
    sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1
}

find_entry() {
    printf '%s\n' "$SESSION_DIRS" | while read -r dir; do
        [ -n "$dir" ] || continue
        if [ -f "$dir/$1" ]; then
            printf '%s\n' "$dir/$1"
            break
        fi
    done | head -n 1
}

# Which of the three drawn icons suits a session. Everything unrecognised is a
# desktop, which is what an unknown session most likely is.
icon_for() {
    case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
    *kodi* | *jellyfin* | *plex* | *mpv* | *media* | *kino*) printf 'media' ;;
    *game* | *steam* | *retro* | *emulation*) printf 'game' ;;
    *) printf 'desktop' ;;
    esac
}

# Game Mode is hand-written rather than discovered: steamos-manager refuses any
# session whose name contains "gamescope", so it never appears in the list below
# and has its own steamosctl verb.
sessions='{"title":"Game Mode","subtitle":"Steam","kind":"game","target":"game-mode"}'

for name in $(steamosctl get-valid-desktop-sessions 2>/dev/null | sed -n 's/^- //p'); do
    # Never offer the picker itself.
    [ "$name" = "${PICKER_SESSION_NAME:-picker.desktop}" ] && continue

    entry=$(find_entry "$name")
    title=$(entry_field "$entry" Name)
    subtitle=$(entry_field "$entry" Comment)
    [ -n "$title" ] || title="$name"
    [ -n "$subtitle" ] || subtitle="$name"

    sessions="$sessions,{\"title\":\"$(json_escape "$title")\",\"subtitle\":\"$(json_escape "$subtitle")\",\"kind\":\"$(icon_for "$name$title")\",\"target\":\"desktop:$name\"}"
done

printf '[%s]\n' "$sessions"
