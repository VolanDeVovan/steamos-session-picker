#!/bin/sh
# The compositor's session command: builds the list of sessions to offer, runs
# the picker, and records what it chose.
#
# This is a separate file because kwin does not forward the output of the
# application it hosts — a line printed by the picker never reaches the process
# that started kwin. So the capture happens here, one level down, where qml is a
# direct child, and the answer leaves through PICKER_CHOICE_FILE.
#
# Not meant to be run by hand; bin/steam-session-picker sets it up.
set -u

sessions=$("$(dirname -- "$0")/list-sessions")

# The room almost always wants what it wanted last time, so that is where the
# cursor starts: power on, press once, gone. Kept in the user's own state
# directory, which survives updates and needs no privileges.
LAST_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/steamos-session-picker/last-choice"
preselect=""
last=$(cat "$LAST_FILE" 2>/dev/null || true)
if [ -n "$last" ]; then
    index=$(printf '%s' "$sessions" | awk -v want="$last" '
        BEGIN { RS = "}"; n = 0 }
        { if (index($0, "\"target\":\"" want "\"") > 0) { print n; exit } n++ }')
    [ -n "$index" ] && preselect="--select=$index"
fi

QML=$("$(dirname -- "$0")/qml-runtime")
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Everything the picker printed is kept: when it fails to start, this file is
# the only place that says why. Without it the filter below swallows the error
# and the screen just stays black.
LOG="${PICKER_LOG:-${XDG_RUNTIME_DIR:-/tmp}/steamos-session-picker.log}"

choice=$(
    # shellcheck disable=SC2086
    "$QML" "$PICKER_QML" -- --fullscreen $preselect --sessions="$sessions" 2>&1 |
        tee -a "$LOG" |
        sed -n 's/.*PICKER_CHOICE:\(.*\)$/\1/p' |
        tail -n 1
) || true

printf '%s\n' "$choice" >"$PICKER_CHOICE_FILE"
printf 'picker: chose [%s], recorded in %s\n' "$choice" "$PICKER_CHOICE_FILE" >>"$LOG"

# Remember it for next time. A cancellation is not a preference.
case "$choice" in
none | "") ;;
*)
    mkdir -p "$(dirname "$LAST_FILE")"
    printf '%s\n' "$choice" >"$LAST_FILE"
    ;;
esac

# kwin keeps holding the screen after the session it hosts exits — measured on a
# Steam Machine, where it sat there until signalled. It does stop on SIGTERM.
#
# It cannot be reached through $PPID: KWin 6 starts its session through the
# systemd user manager, so the parent of this script is systemd, not kwin. The
# compositor is found instead by the command line that only it has — the one
# ending in this very script — which cannot match anything else on the machine,
# including this process.
for pid in $(pgrep -f "kwin_wayland .*compositor-session" 2>/dev/null || true); do
    kill -TERM "$pid" 2>/dev/null || true
done
